+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { applyMiddleware, combineReducers, createStore } from 'redux';
+import thunk from 'redux-thunk';
+
+import apiClient from '../api/Api';
+import queryLogs from '../reducers/queryLogs';
+import access from '../reducers/access';
+import { toggleClientBlock } from '../actions/access';
+import {
+    getLogs, getLogsRequest, getLogsSuccess, receiveLiveLogs, resetLogsView,
+    revealPendingLogs, setFilteredLogs, setLiveLogsEnabled, updateLogs,
+} from '../actions/queryLogs';
+import { normalizeLogs } from '../helpers/helpers';
+
+vi.mock('../api/Api', () => ({
+    default: { getQueryLog: vi.fn(), getAccessList: vi.fn(), setAccessList: vi.fn() },
+}));
+
+const rawRow = (id: number) => ({
+    time: `2026-10-01T12:00:00.${String(id).padStart(9, '0')}Z`, client: '192.0.2.10',
+    question: { name: 'google.com', type: 'A' }, reason: 'FilteredBlackList', status: 'NXDOMAIN',
+    answer: [], rules: [], elapsedMs: '0.01',
+});
+
+const makeStore = () => {
+    const store = createStore(queryLogs);
+    const dispatch: any = (action: any) => typeof action === 'function'
+        ? action(dispatch, () => ({ queryLogs: store.getState() })) : store.dispatch(action);
+    return { store, dispatch };
+};
+
+describe('Query Log request coordination', () => {
+    beforeEach(() => {
+        resetLogsView();
+        vi.mocked(apiClient.getQueryLog).mockReset();
+    });
+
+    it('aborts an obsolete filter request and never replaces the newer filter', async () => {
+        let resolve: (value: any) => void;
+        vi.mocked(apiClient.getQueryLog).mockImplementationOnce(() => new Promise((done) => { resolve = done; }))
+            .mockResolvedValueOnce({ data: [], oldest: '' });
+        const { store, dispatch } = makeStore();
+        const old = dispatch(setFilteredLogs({ search: 'google.com', response_status: 'all' }));
+        const signal = vi.mocked(apiClient.getQueryLog).mock.calls[0][1];
+        await dispatch(setFilteredLogs({ search: 'microsoft.com', response_status: 'blocked' }));
+        expect(signal.aborted).toBe(true);
+        resolve({ data: [], oldest: '' });
+        await old;
+        expect(store.getState().filter).toEqual({ search: 'microsoft.com', response_status: 'blocked' });
+        expect(store.getState().processingGetLogs).toBe(false);
+    });
+
+    it('aborts/reset on leaving without making another API call or accepting late rows', async () => {
+        let resolve: (value: any) => void;
+        vi.mocked(apiClient.getQueryLog).mockImplementationOnce(() => new Promise((done) => { resolve = done; }));
+        const { store, dispatch } = makeStore();
+        const pending = dispatch(setFilteredLogs({ search: 'google.com', response_status: 'all' }));
+        dispatch(resetLogsView());
+        resolve({ data: [], oldest: '' });
+        await pending;
+        expect(apiClient.getQueryLog).toHaveBeenCalledTimes(1);
+        expect(store.getState().logs).toEqual([]);
+        expect(store.getState().filter.search).toBe('');
+    });
+
+    it('prevents ordinary infinite pagination from running while Live is enabled', async () => {
+        const { dispatch } = makeStore();
+        dispatch(getLogsSuccess({ logs: [], oldest: '', older_than: '' }));
+        dispatch(setLiveLogsEnabled(true));
+        await dispatch(getLogs());
+        expect(apiClient.getQueryLog).not.toHaveBeenCalled();
+    });
+
+    it.each([false, true])('preserves paused row-refresh behaviour with populated rows: %s', async (populated) => {
+        const { store, dispatch } = makeStore();
+        const logs = populated ? normalizeLogs([rawRow(1)]) : [];
+        dispatch(getLogsSuccess({ logs, oldest: rawRow(1).time, older_than: '' }));
+        dispatch(getLogsRequest());
+        await dispatch(updateLogs());
+        expect(store.getState().logs).toBe(logs);
+        expect(store.getState().oldest).toBe(rawRow(1).time);
+        expect(store.getState().processingGetLogs).toBe(false);
+        expect(store.getState().isEntireLog).toBe(!populated);
+        expect(apiClient.getQueryLog).not.toHaveBeenCalled();
+    });
+
+    it.each([false, true])('keeps queued queries through client block/unblock (initially blocked: %s)', async (blocked) => {
+        const store = createStore(combineReducers({ queryLogs, access }), applyMiddleware(thunk));
+        const { dispatch }: { dispatch: any } = store;
+        dispatch(getLogsSuccess({ logs: normalizeLogs([rawRow(1)]), oldest: rawRow(1).time, older_than: '' }));
+        dispatch(setLiveLogsEnabled(true));
+        dispatch(receiveLiveLogs({ logs: normalizeLogs([rawRow(2), rawRow(1)]), atTop: false }));
+        const before = store.getState().queryLogs;
+        vi.mocked(apiClient.getAccessList).mockResolvedValue({
+            allowed_clients: [], disallowed_clients: blocked ? ['192.0.2.10'] : [], blocked_hosts: [],
+        });
+        vi.mocked(apiClient.setAccessList).mockResolvedValue(undefined);
+        await dispatch(toggleClientBlock('192.0.2.10', blocked, blocked ? '192.0.2.10' : ''));
+        await dispatch(updateLogs());
+        const after = store.getState().queryLogs;
+        expect(after).toEqual(before);
+        expect(after.logs).toBe(before.logs);
+        expect(after.livePending).toBe(before.livePending);
+        expect(after.livePending).toHaveLength(1);
+        expect(after.liveSeen).toBe(before.liveSeen);
+        expect(after.liveNewest).toBe(before.liveNewest);
+        expect(after.liveFloor).toBe(before.liveFloor);
+        expect(store.getState().access.disallowed_clients).toBe(blocked ? '' : '192.0.2.10');
+        dispatch(receiveLiveLogs({ logs: normalizeLogs([rawRow(2), rawRow(1)]), atTop: false }));
+        expect(store.getState().queryLogs.livePending).toHaveLength(1);
+        dispatch(revealPendingLogs());
+        expect(store.getState().queryLogs.logs.map((row: any) => row.time)).toEqual([rawRow(2).time, rawRow(1).time]);
+        expect(store.getState().queryLogs.livePending).toHaveLength(0);
+        expect(apiClient.getQueryLog).not.toHaveBeenCalled();
+    });
+
+    it('does not complete an active Live filter request when a row refresh finishes', async () => {
+        const { store, dispatch } = makeStore();
+        dispatch(setLiveLogsEnabled(true));
+        let resolve: (value: any) => void;
+        vi.mocked(apiClient.getQueryLog).mockImplementationOnce(() => new Promise((done) => { resolve = done; }));
+        const request = dispatch(setFilteredLogs({ search: 'microsoft.com', response_status: 'blocked' }));
+        await dispatch(updateLogs());
+        expect(store.getState().processingGetLogs).toBe(true);
+        resolve({ data: [], oldest: '' });
+        await request;
+        expect(store.getState().processingGetLogs).toBe(false);
+        expect(store.getState().filter.search).toBe('microsoft.com');
+    });
+
+    it('still appends normal paused pagination and advances its server cursor', async () => {
+        const { store, dispatch } = makeStore();
+        dispatch(getLogsSuccess({ logs: normalizeLogs([rawRow(2)]), oldest: rawRow(2).time, older_than: '' }));
+        vi.mocked(apiClient.getQueryLog).mockResolvedValue({ data: [rawRow(1)], oldest: rawRow(1).time });
+        await dispatch(getLogs());
+        expect(apiClient.getQueryLog).toHaveBeenCalledWith(
+            { ...store.getState().filter, older_than: rawRow(2).time }, expect.any(AbortSignal),
+        );
+        expect(store.getState().logs.map((row: any) => row.time)).toEqual([rawRow(2).time, rawRow(1).time]);
+        expect(store.getState().oldest).toBe(rawRow(1).time);
+    });
+});
