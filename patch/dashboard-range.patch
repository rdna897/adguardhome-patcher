+import { describe, expect, it } from 'vitest';
+
+import { DAY, HOUR } from '../helpers/constants';
+import { getRangeHours, getRecentMs, getStatsRangeKey, isRangeAvailable } from '../helpers/statsRange';
+
+describe('statsRange', () => {
+    const retention = DAY * 30;
+
+    it('returns null for the default range', () => {
+        expect(getRecentMs({ type: 'default' }, retention)).toBeNull();
+    });
+
+    it('converts hour ranges', () => {
+        expect(getRecentMs({ type: 'hours', hours: 6 }, retention)).toBe(6 * HOUR);
+        expect(getRecentMs({ type: 'custom', hours: 13 }, retention)).toBe(13 * HOUR);
+    });
+
+    it('falls back to the retention period for long ranges', () => {
+        expect(getRecentMs({ type: 'hours', hours: 24 * 30 }, retention)).toBeNull();
+        expect(getRecentMs({ type: 'hours', hours: 24 * 7 }, DAY)).toBeNull();
+        expect(isRangeAvailable({ type: 'hours', hours: 24 * 7 }, DAY)).toBe(false);
+        expect(isRangeAvailable({ type: 'hours', hours: 24 }, DAY)).toBe(true);
+    });
+
+    it('counts today including the current hour', () => {
+        expect(getRangeHours({ type: 'today' }, new Date(2026, 9, 1, 0, 10))).toBe(1);
+        expect(getRangeHours({ type: 'today' }, new Date(2026, 9, 1, 9, 33))).toBe(10);
+    });
+
+    it('maps ranges to selector keys', () => {
+        expect(getStatsRangeKey({ type: 'hours', hours: 24 * 7 })).toBe('7d');
+        expect(getStatsRangeKey({ type: 'custom', hours: 5 })).toBe('custom');
+        expect(getStatsRangeKey({ type: 'today' })).toBe('today');
+    });
+});
