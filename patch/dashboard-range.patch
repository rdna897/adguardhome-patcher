--- /dev/null
+++ b/client/src/helpers/liveQueryLog.ts
@@ -0,0 +1,131 @@
+import i18next from 'i18next';
+
+import { LocalStorageHelper } from './localStorageHelper';
+import { BASE_LOCALE } from './twosky';
+
+export const LIVE_LOG_STORAGE_KEY = 'query_log_live';
+export const LIVE_LOG_INTERVAL_MS = 1000;
+export const LIVE_LOG_RETRY_MS = 5000;
+export const LIVE_LOG_PAGE_SIZE = 100;
+// At most 500 rendered rows plus 500 queued rows. Recent identities are also bounded.
+export const LIVE_LOG_MAX_ROWS = 500;
+
+export type LiveLogRow = { time: string; liveKey?: string; [field: string]: any };
+export type LiveLogView = {
+    logs: LiveLogRow[];
+    livePending: LiveLogRow[];
+    liveSeen: string[];
+    liveNewest: string;
+    liveFloor: string;
+};
+
+export const loadLiveLogPreference = () => LocalStorageHelper.getItem(LIVE_LOG_STORAGE_KEY) === true;
+export const saveLiveLogPreference = (enabled: boolean) => LocalStorageHelper.setItem(LIVE_LOG_STORAGE_KEY, enabled);
+
+// Preserve the full API timestamp, including sub-millisecond precision. Client metadata
+// and tracker labels are excluded because they can change between reads of one request.
+const queryIdentity = (row: LiveLogRow) => JSON.stringify([
+    row.time, row.client, row.client_id, row.client_proto, row.domain, row.type,
+    row.reason, row.status, row.response, row.originalResponse, row.rules,
+    row.elapsedMs, row.upstream, row.cached, row.answer_dnssec, row.ecs,
+]);
+
+export const identifyLiveLogs = (rows: LiveLogRow[]): LiveLogRow[] => {
+    const occurrences = new Map<string, number>();
+
+    return rows.slice(0, LIVE_LOG_MAX_ROWS).map((row) => {
+        const identity = queryIdentity(row);
+        const occurrence = occurrences.get(identity) || 0;
+        occurrences.set(identity, occurrence + 1);
+        const liveKey = `${identity}:${occurrence}`;
+
+        // A multiset preserves even indistinguishable records occurring in one page.
+        return row.liveKey === liveKey ? row : { ...row, liveKey };
+    });
+};
+
+const compareTimes = (left: string, right: string) => {
+    const milliseconds = Date.parse(left) - Date.parse(right);
+    const fraction = (time: string) => (time.match(/\.(\d+)/)?.[1] || '').padEnd(9, '0');
+    return milliseconds || fraction(left).localeCompare(fraction(right));
+};
+
+export const createLiveLogView = (rows: LiveLogRow[]): LiveLogView => {
+    const logs = identifyLiveLogs(rows);
+
+    return {
+        logs, livePending: [], liveSeen: logs.map((row) => row.liveKey),
+        liveNewest: logs[0]?.time || '', liveFloor: logs[logs.length - 1]?.time || '',
+    };
+};
+
+export const mergeLiveLogView = <T extends LiveLogView>(state: T, incoming: LiveLogRow[], atTop: boolean): T => {
+    const batch = identifyLiveLogs(incoming);
+    const seen = new Set([
+        ...state.liveSeen,
+        ...state.logs.map((row) => row.liveKey),
+        ...state.livePending.map((row) => row.liveKey),
+    ]);
+    // The regular initial page is smaller than a live page. Do not count older
+    // backfill as new arrivals or reinsert trimmed/cleared history on later polls.
+    const added = batch.filter((row) => !seen.has(row.liveKey)
+        && (!state.liveFloor || compareTimes(row.time, state.liveFloor) >= 0));
+    const newest = batch[0]?.time;
+    const liveNewest = newest && (!state.liveNewest || compareTimes(newest, state.liveNewest) > 0)
+        ? newest : state.liveNewest;
+    const liveSeen = batch.map((row) => row.liveKey);
+    const sameBatch = liveSeen.length === state.liveSeen.length
+        && liveSeen.every((key, index) => key === state.liveSeen[index]);
+
+    if (added.length === 0 && sameBatch) {
+        return state;
+    }
+
+    const newestFirst = (rows: LiveLogRow[]) => rows.sort((left, right) => compareTimes(right.time, left.time));
+    if (!atTop) {
+        return {
+            ...state,
+            liveSeen,
+            liveNewest,
+            livePending: added.length
+                ? newestFirst([...added, ...state.livePending]).slice(0, LIVE_LOG_MAX_ROWS) : state.livePending,
+        };
+    }
+
+    const logs = added.length || state.livePending.length
+        ? newestFirst([...added, ...state.livePending, ...state.logs]).slice(0, LIVE_LOG_MAX_ROWS) : state.logs;
+    return {
+        ...state, liveSeen, liveNewest, logs, livePending: [],
+        liveFloor: logs[logs.length - 1]?.time || state.liveFloor,
+    };
+};
+
+export const revealLiveLogs = <T extends LiveLogView>(state: T): T => {
+    if (!state.livePending.length) {
+        return state;
+    }
+    const logs = [...state.livePending, ...state.logs]
+        .sort((left, right) => compareTimes(right.time, left.time)).slice(0, LIVE_LOG_MAX_ROWS);
+    return { ...state, logs, livePending: [], liveFloor: logs[logs.length - 1]?.time || state.liveFloor };
+};
+
+const LIVE_LOG_STRINGS = {
+    live_log_live: 'Live',
+    live_log_paused: 'Paused',
+    live_log_toggle: 'Live Query Log',
+    live_log_clear: 'Clear view',
+    live_log_clear_hint: 'Clear only this browser view. The server query log is kept.',
+    live_log_new: '{{count}} new query ↑',
+    live_log_new_plural: '{{count}} new queries ↑',
+};
+
+let stringsAdded = false;
+export const ensureLiveLogStrings = () => {
+    if (stringsAdded || !i18next.isInitialized) {
+        return;
+    }
+    [BASE_LOCALE, 'en-us'].forEach((language) => {
+        i18next.addResourceBundle(language, 'translation', LIVE_LOG_STRINGS, true, false);
+    });
+    stringsAdded = true;
+};
diff --git a/client/src/helpers/statsRange.ts b/client/src/helpers/statsRange.ts
new file mode 100644
index 0000000..817e51b
--- /dev/null
+++ b/client/src/helpers/statsRange.ts
@@ -0,0 +1,153 @@
+// Dashboard statistics time range.  The selected range is kept in the browser
+// only, so neither the configuration file nor the statistics database change.
+
+import i18next from 'i18next';
+
+import { HOUR } from './constants';
+import { LocalStorageHelper } from './localStorageHelper';
+import { BASE_LOCALE } from './twosky';
+
+export const STATS_RANGE_STORAGE_KEY = 'dashboard_stats_range';
+
+export const STATS_RANGE_TYPES = {
+    DEFAULT: 'default',
+    HOURS: 'hours',
+    TODAY: 'today',
+    CUSTOM: 'custom',
+};
+
+export type StatsRange = {
+    type: string;
+    // hours is the length of the range in hours for HOURS and CUSTOM types.
+    hours?: number;
+};
+
+export const DEFAULT_STATS_RANGE: StatsRange = { type: STATS_RANGE_TYPES.DEFAULT };
+
+// STATS_RANGE_PRESETS are the predefined ranges shown in the selector.
+export const STATS_RANGE_PRESETS: { key: string; range: StatsRange }[] = [
+    { key: 'default', range: DEFAULT_STATS_RANGE },
+    { key: '1h', range: { type: STATS_RANGE_TYPES.HOURS, hours: 1 } },
+    { key: '6h', range: { type: STATS_RANGE_TYPES.HOURS, hours: 6 } },
+    { key: '12h', range: { type: STATS_RANGE_TYPES.HOURS, hours: 12 } },
+    { key: '24h', range: { type: STATS_RANGE_TYPES.HOURS, hours: 24 } },
+    { key: 'today', range: { type: STATS_RANGE_TYPES.TODAY } },
+    { key: '7d', range: { type: STATS_RANGE_TYPES.HOURS, hours: 24 * 7 } },
+    { key: '30d', range: { type: STATS_RANGE_TYPES.HOURS, hours: 24 * 30 } },
+    { key: 'custom', range: { type: STATS_RANGE_TYPES.CUSTOM } },
+];
+
+const isValidHours = (hours: unknown): hours is number =>
+    typeof hours === 'number' && Number.isInteger(hours) && hours > 0;
+
+export const getStatsRangeKey = (range: StatsRange): string => {
+    if (range.type === STATS_RANGE_TYPES.HOURS) {
+        const preset = STATS_RANGE_PRESETS.find(
+            (p) => p.range.type === STATS_RANGE_TYPES.HOURS && p.range.hours === range.hours,
+        );
+
+        return preset ? preset.key : 'custom';
+    }
+
+    return range.type;
+};
+
+export const loadStatsRange = (): StatsRange => {
+    const stored = LocalStorageHelper.getItem(STATS_RANGE_STORAGE_KEY);
+    if (!stored || typeof stored !== 'object') {
+        return DEFAULT_STATS_RANGE;
+    }
+
+    const { type, hours } = stored;
+    switch (type) {
+        case STATS_RANGE_TYPES.TODAY:
+            return { type };
+        case STATS_RANGE_TYPES.HOURS:
+        case STATS_RANGE_TYPES.CUSTOM:
+            return isValidHours(hours) ? { type, hours } : DEFAULT_STATS_RANGE;
+        default:
+            return DEFAULT_STATS_RANGE;
+    }
+};
+
+export const saveStatsRange = (range: StatsRange) => {
+    LocalStorageHelper.setItem(STATS_RANGE_STORAGE_KEY, range);
+};
+
+// getRangeHours returns the number of hourly statistics units the range
+// covers.  The statistics are stored per clock hour, and the current hour is
+// always included, so "today" is the hours elapsed since local midnight plus
+// the current one.
+export const getRangeHours = (range: StatsRange, now: Date = new Date()): number | null => {
+    switch (range.type) {
+        case STATS_RANGE_TYPES.HOURS:
+        case STATS_RANGE_TYPES.CUSTOM:
+            return isValidHours(range.hours) ? range.hours : null;
+        case STATS_RANGE_TYPES.TODAY: {
+            const midnight = new Date(now);
+            midnight.setHours(0, 0, 0, 0);
+
+            return Math.floor((now.getTime() - midnight.getTime()) / HOUR) + 1;
+        }
+        default:
+            return null;
+    }
+};
+
+// getRecentMs returns the value of the "recent" parameter of GET /control/stats
+// for the range, or null if the full retention period should be requested.
+// retentionMs is the statistics retention period.
+export const getRecentMs = (range: StatsRange, retentionMs: number, now: Date = new Date()): number | null => {
+    const hours = getRangeHours(range, now);
+    if (hours === null || !retentionMs) {
+        return null;
+    }
+
+    const recentMs = hours * HOUR;
+
+    return recentMs >= retentionMs ? null : recentMs;
+};
+
+// isRangeAvailable returns false if the range is longer than the retention
+// period.
+export const isRangeAvailable = (range: StatsRange, retentionMs: number): boolean => {
+    if (range.type !== STATS_RANGE_TYPES.HOURS) {
+        return true;
+    }
+
+    return !retentionMs || (range.hours ?? 0) * HOUR <= retentionMs;
+};
+
+// STATS_RANGE_STRINGS are added at runtime instead of to the locale files, so
+// that the patch doesn't touch files that change in every release.  Other
+// languages fall back to these.
+const STATS_RANGE_STRINGS = {
+    stats_range_label: 'Statistics time range',
+    stats_range_default: 'Default (retention period)',
+    stats_range_today: 'Today',
+    stats_range_for_today: 'for today',
+    stats_range_custom: 'Custom',
+    stats_range_last_hours: 'Last {{count}} hour',
+    stats_range_last_hours_plural: 'Last {{count}} hours',
+    stats_range_last_days: 'Last {{count}} day',
+    stats_range_last_days_plural: 'Last {{count}} days',
+    stats_range_unit_hours: 'hours',
+    stats_range_unit_days: 'days',
+    stats_range_too_long: 'Longer than the statistics retention period',
+};
+
+let stringsAdded = false;
+
+// ensureStatsRangeStrings adds the selector's strings to the base locale.  It
+// must be called after i18next is initialized.
+export const ensureStatsRangeStrings = () => {
+    if (stringsAdded || !i18next.isInitialized) {
+        return;
+    }
+
+    [BASE_LOCALE, 'en-us'].forEach((lng) => {
+        i18next.addResourceBundle(lng, 'translation', STATS_RANGE_STRINGS, true, false);
+    });
+
+    stringsAdded = true;
+};
