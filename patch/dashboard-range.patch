@@ -0,0 +1,266 @@
+import React, { useRef } from 'react';
+import ReactDOM from 'react-dom';
+import { act } from 'react-dom/test-utils';
+import { Provider } from 'react-redux';
+import { combineReducers, createStore } from 'redux';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import apiClient from '../api/Api';
+import { getLogsRequest, getLogsSuccess, setLogsFilter, updateLogs } from '../actions/queryLogs';
+import queryLogs from '../reducers/queryLogs';
+import { useLiveQueryLog } from '../components/Logs/useLiveQueryLog';
+import { LIVE_LOG_STORAGE_KEY } from '../helpers/liveQueryLog';
+
+vi.mock('../api/Api', () => ({ default: { getQueryLog: vi.fn(), clearQueryLog: vi.fn() } }));
+
+const rawRow = (id: number) => ({
+    time: `2026-10-01T12:00:00.${String(id).padStart(9, '0')}Z`, client: '192.0.2.10',
+    question: { name: 'google.com', type: 'A' }, reason: 'FilteredBlackList', status: 'NXDOMAIN',
+    answer: [], rules: [], elapsedMs: '0.01',
+});
+const response = (...ids: number[]) => ({ data: ids.map(rawRow), oldest: '' });
+
+describe('Live Query Log polling lifecycle', () => {
+    let container: HTMLDivElement;
+    let store: any;
+    let controls: ReturnType<typeof useLiveQueryLog>;
+    let tableTop: number;
+    const visibleDescriptor = Object.getOwnPropertyDescriptor(document, 'visibilityState');
+
+    const Harness = () => {
+        const table = useRef<HTMLDivElement>(null);
+        controls = useLiveQueryLog(table);
+        return <div ref={table} />;
+    };
+    const mount = (live = true) => {
+        localStorage.setItem(LIVE_LOG_STORAGE_KEY, JSON.stringify(live));
+        act(() => { ReactDOM.render(<Provider store={store}><Harness /></Provider>, container); });
+        const element = container.firstElementChild as HTMLDivElement;
+        vi.spyOn(element, 'getBoundingClientRect').mockImplementation(() => ({ top: tableTop } as DOMRect));
+        element.scrollIntoView = vi.fn();
+        return element;
+    };
+    const tick = async (ms = 1000) => {
+        await act(async () => { await vi.advanceTimersByTimeAsync(ms); });
+    };
+    const visibility = (state: 'visible' | 'hidden') => {
+        Object.defineProperty(document, 'visibilityState', { configurable: true, value: state });
+        act(() => { document.dispatchEvent(new Event('visibilitychange')); });
+    };
+
+    beforeEach(() => {
+        vi.useFakeTimers();
+        vi.mocked(apiClient.getQueryLog).mockReset().mockResolvedValue(response(1));
+        localStorage.clear();
+        tableTop = 0;
+        Object.defineProperty(document, 'visibilityState', { configurable: true, value: 'visible' });
+        container = document.createElement('div');
+        document.body.appendChild(container);
+        const reducer = combineReducers({
+            queryLogs,
+            errors: (state: any[], action: any) => action.type === 'ADD_ERROR_TOAST' ? [...(state || []), action.payload] : (state || []),
+        });
+        store = createStore(reducer, {
+            ...reducer(undefined, { type: '@@init', payload: undefined }),
+            queryLogs: { ...queryLogs(undefined, { type: '@@init', payload: undefined }), processingGetLogs: false },
+        });
+    });
+
+    afterEach(() => {
+        act(() => { ReactDOM.unmountComponentAtNode(container); });
+        container.remove();
+        expect(apiClient.clearQueryLog).not.toHaveBeenCalled();
+        vi.restoreAllMocks();
+        vi.useRealTimers();
+        if (visibleDescriptor) {
+            Object.defineProperty(document, 'visibilityState', visibleDescriptor);
+        } else {
+            delete (document as any).visibilityState;
+        }
+    });
+
+    it('restores Live, polls at one second, persists pause, and stops requests', async () => {
+        mount();
+        await tick(999);
+        expect(apiClient.getQueryLog).not.toHaveBeenCalled();
