+import React from 'react';
+import ReactDOM from 'react-dom';
+import { act } from 'react-dom/test-utils';
+import { Provider } from 'react-redux';
+import { createStore } from 'redux';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import Line from '../components/ui/Line';
+import { DAY, TIME_UNITS } from '../helpers/constants';
+
+// Give the real Recharts area a fixed viewport in jsdom.
+vi.mock('recharts', async (importOriginal) => {
+    const actual = await importOriginal<typeof import('recharts')>();
+
+    return {
+        ...actual,
+        ResponsiveContainer: ({ children }: { children: React.ReactElement }) =>
+            React.cloneElement(children, { width: 400, height: 120 }),
+    };
+});
+
+describe('dashboard chart rendering', () => {
+    let container: HTMLDivElement;
+
+    afterEach(() => {
+        if (container) {
+            ReactDOM.unmountComponentAtNode(container);
+            container.remove();
+        }
+    });
+
+    it.each([[3118], [447], [0]])('draws a full-width area/line for the single bucket %j', (value) => {
+        container = document.createElement('div');
+        document.body.appendChild(container);
+        const store = createStore(() => ({ stats: { interval: 30 * DAY, timeUnits: TIME_UNITS.HOURS } }));
+
+        act(() => {
+            ReactDOM.render(
+                <Provider store={store}>
+                    <Line data={[value]} color="#F67247" />
+                </Provider>,
+                container,
+            );
+        });
+
+        const curve = container.querySelector('.recharts-area-curve');
+        const path = curve?.getAttribute('d');
+        const endpoints = path?.match(/^M([\d.]+),([\d.]+)L([\d.]+),([\d.]+)$/);
+
+        expect(endpoints).not.toBeNull();
+        expect(Number(endpoints?.[3]) - Number(endpoints?.[1])).toBeGreaterThan(300);
+        expect(endpoints?.[2]).toBe(endpoints?.[4]);
+        expect(container.querySelector('.recharts-area-area')).not.toBeNull();
+        expect(container.querySelectorAll('.recharts-dot')).toHaveLength(0);
+    });
+});
