@@ -0,0 +1,148 @@
+import React, { useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import { HOUR } from '../../helpers/constants';
+import {
+    STATS_RANGE_PRESETS,
+    STATS_RANGE_TYPES,
+    StatsRange,
+    ensureStatsRangeStrings,
+    getStatsRangeKey,
+    isRangeAvailable,
+} from '../../helpers/statsRange';
+
+const CUSTOM_UNITS = {
+    HOURS: 'hours',
+    DAYS: 'days',
+};
+
+interface StatsRangeSelectorProps {
+    range: StatsRange;
+    retentionMs: number;
+    disabled?: boolean;
+    onChange: (range: StatsRange) => void;
+}
+
+const getPresetLabel = (t: (key: string, options?: object) => string, key: string) => {
+    switch (key) {
+        case 'default':
+            return t('stats_range_default');
+        case 'today':
+            return t('stats_range_today');
+        case 'custom':
+            return t('stats_range_custom');
+        default: {
+            const preset = STATS_RANGE_PRESETS.find((p) => p.key === key);
+            const hours = preset?.range.hours ?? 0;
+
+            return hours >= 48 && hours % 24 === 0
+                ? t('stats_range_last_days', { count: hours / 24 })
+                : t('stats_range_last_hours', { count: hours });
+        }
+    }
+};
+
+const StatsRangeSelector = ({ range, retentionMs, disabled, onChange }: StatsRangeSelectorProps) => {
+    ensureStatsRangeStrings();
+    const { t } = useTranslation();
+
+    const selectedKey = getStatsRangeKey(range);
+    const [showCustom, setShowCustom] = useState(selectedKey === 'custom');
+    const [customValue, setCustomValue] = useState('');
+    const [customUnit, setCustomUnit] = useState(CUSTOM_UNITS.HOURS);
+
+    useEffect(() => {
+        if (selectedKey !== 'custom' || !range.hours) {
+            return;
+        }
+
+        if (range.hours % 24 === 0) {
+            setCustomValue(String(range.hours / 24));
+            setCustomUnit(CUSTOM_UNITS.DAYS);
+        } else {
+            setCustomValue(String(range.hours));
+            setCustomUnit(CUSTOM_UNITS.HOURS);
+        }
+    }, [selectedKey, range.hours]);
+
+    const customNumber = Number(customValue);
+    const customHours = customUnit === CUSTOM_UNITS.DAYS ? customNumber * 24 : customNumber;
+    const customValid = Number.isInteger(customNumber) && customNumber > 0;
+    const customTooLong = customValid && retentionMs > 0 && customHours * HOUR > retentionMs;
+
+    const handleSelect = (e: React.ChangeEvent<HTMLSelectElement>) => {
+        const { value } = e.target;
+        if (value === 'custom') {
+            setShowCustom(true);
+
+            return;
+        }
+
+        setShowCustom(false);
+
+        const preset = STATS_RANGE_PRESETS.find((p) => p.key === value);
+        if (preset) {
+            onChange(preset.range);
+        }
+    };
+
+    const applyCustom = (e: React.FormEvent) => {
+        e.preventDefault();
+        if (!customValid || customTooLong) {
+            return;
+        }
+
+        onChange({ type: STATS_RANGE_TYPES.CUSTOM, hours: customHours });
+    };
+
+    return (
+        <div className="stats-range">
+            <select
+                className="form-control custom-select custom-select-sm stats-range__select"
+                aria-label={t('stats_range_label')}
+                title={t('stats_range_label')}
+                value={showCustom ? 'custom' : selectedKey}
+                disabled={disabled}
+                onChange={handleSelect}>
+                {STATS_RANGE_PRESETS.map(({ key, range: presetRange }) => (
+                    <option key={key} value={key} disabled={!isRangeAvailable(presetRange, retentionMs)}>
+                        {getPresetLabel(t, key)}
+                    </option>
+                ))}
+            </select>
+
+            {showCustom && (
+                <form className="stats-range__custom" onSubmit={applyCustom}>
+                    <input
+                        type="number"
+                        min={1}
+                        step={1}
+                        className="form-control form-control-sm stats-range__input"
+                        aria-label={t('stats_range_custom')}
+                        placeholder="12"
+                        value={customValue}
+                        onChange={(e) => setCustomValue(e.target.value)}
+                    />
+
+                    <select
+                        className="form-control custom-select custom-select-sm stats-range__unit"
+                        value={customUnit}
+                        onChange={(e) => setCustomUnit(e.target.value)}>
+                        <option value={CUSTOM_UNITS.HOURS}>{t('stats_range_unit_hours')}</option>
+                        <option value={CUSTOM_UNITS.DAYS}>{t('stats_range_unit_days')}</option>
+                    </select>
+
+                    <button
+                        type="submit"
+                        className="btn btn-outline-primary btn-sm"
+                        disabled={!customValid || customTooLong || disabled}
+                        title={customTooLong ? t('stats_range_too_long') : undefined}>
+                        {t('apply_btn')}
+                    </button>
+                </form>
+            )}
+        </div>
+    );
+};
+
+export default StatsRangeSelector;
