+                    } else {
+                        dispatch(receiveLiveLogs({ logs: result.logs, atTop: atTop.current, fromTime }));
+                    }
+                    checkpoint.current = result.checkpoint;
+                    gap.current = gap.current || result.gap;
+                    setHasGap(gap.current);
+                    if (result.error) throw result.error;
+                    failed.current = false;
+                    setPhase('synced');
+                }
+            } catch (error) {
