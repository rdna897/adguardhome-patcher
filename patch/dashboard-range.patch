diff --git a/client/src/components/Logs/useLiveQueryLog.ts b/client/src/components/Logs/useLiveQueryLog.ts
new file mode 100644
index 0000000..ce0b68d
--- /dev/null
+++ b/client/src/components/Logs/useLiveQueryLog.ts
@@ -0,0 +1,136 @@
+import { RefObject, useCallback, useEffect, useRef, useState } from 'react';
+import { shallowEqual, useDispatch, useSelector } from 'react-redux';
+
+import apiClient from '../../api/Api';
+import { addErrorToast } from '../../actions/toasts';
+import { clearLiveLogsView, receiveLiveLogs, revealPendingLogs, setLiveLogsEnabled } from '../../actions/queryLogs';
+import { normalizeLogs } from '../../helpers/helpers';
+import {
+    LIVE_LOG_INTERVAL_MS, LIVE_LOG_PAGE_SIZE, LIVE_LOG_RETRY_MS,
+    loadLiveLogPreference, saveLiveLogPreference,
+} from '../../helpers/liveQueryLog';
+import { RootState } from '../../initialState';
+
+export const useLiveQueryLog = (table: RefObject<HTMLDivElement>) => {
+    const dispatch = useDispatch();
+    const { enabled, filter, processingGetConfig, processingGetLogs, livePending } = useSelector(
+        (state: RootState) => state.queryLogs, shallowEqual,
+    );
+    const [live, setLive] = useState(loadLiveLogPreference);
+    const busy = useRef(false);
+    const atTop = useRef(true);
+    const filterKey = JSON.stringify(filter || {});
+    const active = useRef(false);
+    const latestFilter = useRef(filterKey);
+    // Passive-effect cleanup can follow a render; stop the old loop immediately.
+    active.current = live && enabled && !processingGetConfig && !processingGetLogs;
+    latestFilter.current = filterKey;
+
+    useEffect(() => {
+        dispatch(setLiveLogsEnabled(live));
+    }, [live]);
+
+    useEffect(() => {
+        if (!live || !enabled || processingGetConfig) {
+            return undefined;
+        }
+        const element = table.current;
+        const onScroll = () => {
+            atTop.current = !element || (element.getBoundingClientRect().top >= -48 && element.scrollTop <= 8);
+            if (atTop.current) {
+                dispatch(revealPendingLogs());
+            }
+        };
+        onScroll();
+        window.addEventListener('scroll', onScroll, { passive: true });
+        element?.addEventListener('scroll', onScroll, { passive: true });
+        return () => {
+            window.removeEventListener('scroll', onScroll);
+            element?.removeEventListener('scroll', onScroll);
+        };
+    }, [live, enabled, processingGetConfig, table]);
+
+    useEffect(() => {
+        if (!live || !enabled || processingGetConfig || processingGetLogs) {
+            return undefined;
+        }
+        let stopped = false;
+        let timer: ReturnType<typeof setTimeout>;
+        let controller: AbortController;
+        let failed = false;
+        const currentFilter = JSON.parse(filterKey);
+        const current = () => !stopped && active.current && latestFilter.current === filterKey;
+        const visible = () => document.visibilityState !== 'hidden';
+        async function poll() {
+            if (!current() || !visible()) {
+                return;
+            }
+            if (busy.current) {
+                timer = setTimeout(poll, LIVE_LOG_INTERVAL_MS);
+                return;
+            }
+            busy.current = true;
+            controller = new AbortController();
+            try {
+                const response = await apiClient.getQueryLog(
+                    { ...currentFilter, limit: LIVE_LOG_PAGE_SIZE }, controller.signal,
+                );
+                if (current() && !controller.signal.aborted && visible()) {
+                    dispatch(receiveLiveLogs({ logs: normalizeLogs(response.data), atTop: atTop.current }));
+                    failed = false;
+                }
+            } catch (error) {
+                if (current() && !controller.signal.aborted) {
+                    // One toast per outage; retry slowly until a successful poll recovers.
+                    if (!failed) {
+                        dispatch(addErrorToast({ error }));
+                    }
+                    failed = true;
+                }
+            } finally {
+                busy.current = false;
+                clearTimeout(timer);
+                if (current() && visible()) {
+                    timer = setTimeout(poll, failed ? LIVE_LOG_RETRY_MS : LIVE_LOG_INTERVAL_MS);
+                }
+            }
+        }
+        const onVisibility = () => {
+            clearTimeout(timer);
+            if (current() && visible()) {
+                timer = setTimeout(poll, 0);
+            } else {
+                controller?.abort();
+            }
+        };
+        document.addEventListener('visibilitychange', onVisibility);
+        if (visible()) {
+            timer = setTimeout(poll, LIVE_LOG_INTERVAL_MS);
+        }
+        return () => {
+            stopped = true;
+            clearTimeout(timer);
+            controller?.abort();
+            document.removeEventListener('visibilitychange', onVisibility);
+        };
+    }, [live, enabled, filterKey, processingGetConfig, processingGetLogs]);
+
+    const toggleLive = useCallback(() => {
+        setLive((previous) => {
+            saveLiveLogPreference(!previous);
+            return !previous;
+        });
+    }, []);
+    const clearView = () => dispatch(clearLiveLogsView());
+    const showNewest = () => {
+        dispatch(revealPendingLogs());
+        const element = table.current;
+        if (element) {
+            element.scrollTop = 0;
+            element.scrollIntoView({ block: 'start', behavior: 'auto' });
+        }
+        atTop.current = true;
+    };
+
+    return { live, toggleLive, clearView, showNewest, pendingCount: livePending.length };
+};
