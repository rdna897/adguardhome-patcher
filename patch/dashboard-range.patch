+                    if (timedOut && newestPage) {
+                        // Accept a new boundary only with a persistent gap warning, so a slow
+                        // backfill is not restarted on every retry. Keep successfully read rows.
+                        const logs = [...processed.values()]
+                            .sort((left, right) => compareTimes(right.time, left.time));
+                        const head = checkpointFor(logs);
+                        checkpoint.current = head.time ? head : { ...checkpoint.current, limited: true };
+                        gap.current = true;
+                        setHasGap(true);
+                        if (baselineOnly.current) {
+                            dispatch(clearLiveLogsView({ through: observedHead.current }));
+                            baselineOnly.current = false;
+                        } else {
+                            dispatch(receiveLiveLogs({ logs, atTop: atTop.current, fromTime }));
+                        }
+                        failed.current = false;
+                        setPhase('synced');
+                        return;
+                    }
+                    // One toast per outage, including across pause/visibility lifecycle changes.
+                    if (!failed.current) dispatch(addErrorToast({ error }));
+                    failed.current = true;
+                    setPhase('reconnecting');
+                }
+            } finally {
+                clearTimeout(deadline);
+                cancelForAvailability = undefined;
+                busy.current = false;
+                clearTimeout(timer);
+                if (current() && available()) {
+                    timer = setTimeout(poll, failed.current ? LIVE_LOG_RETRY_MS : LIVE_LOG_INTERVAL_MS);
+                }
+            }
+        }
+        const onAvailability = () => {
+            clearTimeout(timer);
+            if (current() && available()) {
+                setPhase('catching_up');
+                timer = setTimeout(poll, 0);
+            } else {
+                cancelForAvailability?.();
+                if (current()) setPhase(visible() ? 'reconnecting' : 'suspended');
+            }
+        };
+        document.addEventListener('visibilitychange', onAvailability);
+        window.addEventListener('online', onAvailability);
+        window.addEventListener('offline', onAvailability);
+        if (available()) {
+            setPhase('catching_up');
+            timer = setTimeout(poll, LIVE_LOG_INTERVAL_MS);
+        } else {
+            setPhase(visible() ? 'reconnecting' : 'suspended');
+        }
+        return () => {
+            stopped = true;
+            clearTimeout(timer);
+            controller?.abort();
+            document.removeEventListener('visibilitychange', onAvailability);
+            window.removeEventListener('online', onAvailability);
+            window.removeEventListener('offline', onAvailability);
+        };
+    }, [live, enabled, filterKey, processingGetConfig, processingGetLogs, clearRevision]);
+
+    const toggleLive = useCallback(() => {
+        setLive((previous) => {
+            saveLiveLogPreference(!previous);
+            return !previous;
+        });
+    }, []);
+    const clearView = () => {
+        // Invalidate synchronously so a queued old response cannot refill the cleared table.
+        clearGeneration.current += 1;
+        abort.current?.abort();
+        cancelLogsRequest();
+        baselineOnly.current = checkpoint.current === null;
+        dispatch(clearLiveLogsView({ through: observedHead.current }));
+        setClearRevision((revision) => revision + 1);
+    };
+    const showNewest = () => {
+        dispatch(revealPendingLogs());
+        const element = table.current;
+        if (element) {
+            element.scrollTop = 0;
+            element.scrollIntoView({ block: 'start', behavior: 'auto' });
+        }
+        atTop.current = true;
+    };
+
+    const status = live ? phase : 'paused';
+    return {
+        live, toggleLive, clearView, showNewest, pendingCount: livePending.length,
+        status: hasGap && status === 'synced' ? 'gap' : status, hasGap,
+    };
+};
