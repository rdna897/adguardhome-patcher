+import { describe, expect, it } from 'vitest';
+
+import { TIME_UNITS } from '../helpers/constants';
+import { buildChartData } from '../components/ui/lineUtils';
+
+describe('dashboard chart history', () => {
+    const now = new Date(2026, 9, 1, 10, 30).getTime();
+
+    it('shows a single hour as a flat value with one hourly tooltip', () => {
+        const values = [3118];
+        const points = buildChartData(values, TIME_UNITS.HOURS, now);
+
+        expect(points).toHaveLength(2);
+        expect(points.map((point) => point.value)).toEqual([3118, 3118]);
+        expect(points.map((point) => point.label)).toEqual(['1 Oct 10:00', '1 Oct 10:00']);
+        expect(values).toEqual([3118]);
+    });
+
+    it('keeps a single zero bucket at zero', () => {
+        expect(buildChartData([0], TIME_UNITS.HOURS, now).map((point) => point.value)).toEqual([0, 0]);
+    });
+
+    it('labels a shorter hourly range using the returned buckets', () => {
+        const points = buildChartData([10, 20, 30], TIME_UNITS.HOURS, now);
+
+        expect(points.map((point) => point.value)).toEqual([10, 20, 30]);
+        expect(points.map((point) => point.label)).toEqual(['1 Oct 08:00', '1 Oct 09:00', '1 Oct 10:00']);
+    });
+
+    it('keeps daily history anchored to today', () => {
+        expect(buildChartData([10, 20], TIME_UNITS.DAYS, now).map((point) => point.label)).toEqual([
+            '30 Sep 2026',
+            '1 Oct 2026',
+        ]);
+    });
+
+    it('keeps empty history empty', () => {
+        expect(buildChartData([], TIME_UNITS.HOURS, now)).toEqual([]);
+    });
+});
diff --git a/client/src/__tests__/liveQueryLog.test.ts b/client/src/__tests__/liveQueryLog.test.ts
new file mode 100644
index 0000000..b660f72
--- /dev/null
+++ b/client/src/__tests__/liveQueryLog.test.ts
@@ -0,0 +1,110 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+    createLiveLogView, LIVE_LOG_MAX_ROWS, mergeLiveLogView, revealLiveLogs,
+} from '../helpers/liveQueryLog';
+import queryLogs from '../reducers/queryLogs';
+import { clearLiveLogsView, receiveLiveLogs, setLiveLogsEnabled } from '../actions/queryLogs';
+
+const row = (time: string, extra = {}) => ({
+    time, client: '192.0.2.10', domain: 'google.com', type: 'A', reason: 'FilteredBlackList',
+    status: 'NXDOMAIN', response: [], originalResponse: [], elapsedMs: '0.012', rules: [], ...extra,
+});
+const rows = (count: number, offset = 0) => Array.from({ length: count }, (_, index) =>
+    row(`2026-10-01T12:00:00.${String(count + offset - index).padStart(9, '0')}Z`));
+
+describe('bounded Live Query Log view', () => {
+    it('prepends only new queries and reuses existing row objects and unchanged state', () => {
+        const first = row('2026-10-01T12:00:00.000000001Z');
+        const state = createLiveLogView([first]);
+        const next = mergeLiveLogView(state, [row('2026-10-01T12:00:00.000000002Z'), first], true);
+        expect(next.logs).toHaveLength(2);
+        expect(next.logs[1]).toBe(state.logs[0]);
+        expect(mergeLiveLogView(next, [next.logs[0], first], true)).toBe(next);
+    });
+
+    it('preserves full timestamps and distinguishes immutable request/response fields', () => {
+        const base = row('2026-10-01T12:00:00.000000001Z');
+        const incoming = [
+            row('2026-10-01T12:00:00.000000002Z'),
+            { ...base, client: '192.0.2.20' },
+            { ...base, type: 'AAAA' },
+            { ...base, elapsedMs: '0.014' },
+            { ...base, response: ['A: 192.0.2.1 (ttl=60)'] },
+            { ...base, reason: 'NotFilteredNotFound', status: 'NOERROR' },
+            base,
+        ];
+        expect(mergeLiveLogView(createLiveLogView([base]), incoming, true).logs).toHaveLength(7);
+    });
+
+    it('ignores mutable client metadata and retains multiplicity within a page', () => {
+        const base = row('2026-10-01T12:00:00.123456789Z');
+        const state = createLiveLogView([base, base]);
+        const renamed = { ...base, client_info: { name: 'Renamed client' }, tracker: { name: 'Updated' } };
+        expect(mergeLiveLogView(state, [renamed, renamed], true)).toBe(state);
+        const next = mergeLiveLogView(state, [base, base, base], true);
+        expect(next.logs).toHaveLength(3);
+        expect(new Set(next.logs.map((entry) => entry.liveKey)).size).toBe(3);
+    });
+
+    it('queues arrivals without changing displayed rows until they are revealed', () => {
+        const state = createLiveLogView(rows(5));
+        const pending = mergeLiveLogView(state, rows(2, 5), false);
+        expect(pending.logs).toBe(state.logs);
+        expect(pending.livePending).toHaveLength(2);
+        expect(mergeLiveLogView(pending, rows(2, 5), false)).toBe(pending);
+        const revealed = revealLiveLogs(pending);
+        expect(revealed.logs).toHaveLength(7);
+        expect(revealed.livePending).toHaveLength(0);
+        expect(revealed.logs[2]).toBe(state.logs[0]);
+    });
+
+    it('does not mistake a larger newest page or stale cache for new arrivals', () => {
+        const initial = rows(20, 80);
+        const state = createLiveLogView(initial);
+        const older = mergeLiveLogView(state, rows(100), false);
+        expect(older.logs).toBe(state.logs);
+        expect(older.livePending).toHaveLength(0);
+        const newQueries = mergeLiveLogView(older, rows(100, 2), false);
+        expect(newQueries.livePending).toHaveLength(2);
+        expect(mergeLiveLogView(newQueries, rows(100), false).livePending).toHaveLength(2);
+    });
+
+    it('retains a late completed request within the view window in timestamp order', () => {
+        const state = createLiveLogView(rows(5));
+        const delayed = row('2026-10-01T12:00:00.000000003Z', { elapsedMs: '1200.5' });
+        const next = mergeLiveLogView(state, [...rows(5), delayed], true);
+        expect(next.logs).toHaveLength(6);
+        expect(next.logs[2].elapsedMs).toBe('1200.5');
+        expect(next.logs.map((entry) => entry.time)).toEqual([
+            ...rows(5).slice(0, 3).map((entry) => entry.time),
+            ...rows(5).slice(2).map((entry) => entry.time),
+        ]);
+    });
+
+    it('bounds displayed rows, queued rows, and recent identities in long sessions', () => {
+        let state = createLiveLogView(rows(2000));
+        expect(state.logs).toHaveLength(LIVE_LOG_MAX_ROWS);
+        for (let index = 0; index < 30; index += 1) {
+            state = mergeLiveLogView(state, rows(100, 2000 + index * 100), false);
+            expect(state.logs.length).toBeLessThanOrEqual(500);
+            expect(state.livePending.length).toBeLessThanOrEqual(500);
+            expect(state.liveSeen.length).toBeLessThanOrEqual(500);
+        }
+        const revealed = revealLiveLogs(state);
+        expect(revealed.logs).toHaveLength(500);
+        expect(revealed.livePending).toHaveLength(0);
+    });
+
+    it('clears only the view and does not reinsert an unchanged newest page', () => {
+        let state: any = queryLogs(undefined, { type: '@@init', payload: undefined });
+        state = { ...state, logs: rows(5) };
+        state = queryLogs(state, setLiveLogsEnabled(true));
+        state = queryLogs(state, clearLiveLogsView());
+        expect(state.logs).toEqual([]);
+        state = queryLogs(state, receiveLiveLogs({ logs: rows(5), atTop: true }));
+        expect(state.logs).toEqual([]);
+        state = queryLogs(state, receiveLiveLogs({ logs: rows(6), atTop: true }));
+        expect(state.logs).toHaveLength(1);
+    });
+});
