@@ -0,0 +1,40 @@
+import { describe, expect, it } from 'vitest';
+
+import { TIME_UNITS } from '../helpers/constants';
+import { buildChartData } from '../components/ui/lineUtils';
+
+describe('dashboard chart history', () => {
+    const now = new Date(2026, 9, 1, 10, 30).getTime();
+
+    it('shows a single hour as a flat value with one hourly tooltip', () => {
+        const values = [3118];
+        const points = buildChartData(values, TIME_UNITS.HOURS, now);
+
+        expect(points).toHaveLength(2);
+        expect(points.map((point) => point.value)).toEqual([3118, 3118]);
+        expect(points.map((point) => point.label)).toEqual(['1 Oct 10:00', '1 Oct 10:00']);
+        expect(values).toEqual([3118]);
+    });
+
+    it('keeps a single zero bucket at zero', () => {
+        expect(buildChartData([0], TIME_UNITS.HOURS, now).map((point) => point.value)).toEqual([0, 0]);
+    });
+
+    it('labels a shorter hourly range using the returned buckets', () => {
+        const points = buildChartData([10, 20, 30], TIME_UNITS.HOURS, now);
+
+        expect(points.map((point) => point.value)).toEqual([10, 20, 30]);
+        expect(points.map((point) => point.label)).toEqual(['1 Oct 08:00', '1 Oct 09:00', '1 Oct 10:00']);
+    });
+
+    it('keeps daily history anchored to today', () => {
+        expect(buildChartData([10, 20], TIME_UNITS.DAYS, now).map((point) => point.label)).toEqual([
+            '30 Sep 2026',
+            '1 Oct 2026',
+        ]);
+    });
+
+    it('keeps empty history empty', () => {
+        expect(buildChartData([], TIME_UNITS.HOURS, now)).toEqual([]);
+    });
+});
diff --git a/client/src/__tests__/liveQueryLog.test.ts b/client/src/__tests__/liveQueryLog.test.ts
new file mode 100644
index 0000000..b660f72
--- /dev/null
+++ b/client/src/__tests__/liveQueryLog.test.ts
@@ -0,0 +1,110 @@
+import { describe, expect, it } from 'vitest';
+
+import {
+    createLiveLogView, LIVE_LOG_MAX_ROWS, mergeLiveLogView, revealLiveLogs,
+} from '../helpers/liveQueryLog';
+import queryLogs from '../reducers/queryLogs';
+import { clearLiveLogsView, receiveLiveLogs, setLiveLogsEnabled } from '../actions/queryLogs';
+
+const row = (time: string, extra = {}) => ({
+    time, client: '192.0.2.10', domain: 'google.com', type: 'A', reason: 'FilteredBlackList',
+    status: 'NXDOMAIN', response: [], originalResponse: [], elapsedMs: '0.012', rules: [], ...extra,
+});
+const rows = (count: number, offset = 0) => Array.from({ length: count }, (_, index) =>
+    row(`2026-10-01T12:00:00.${String(count + offset - index).padStart(9, '0')}Z`));
+
+describe('bounded Live Query Log view', () => {
+    it('prepends only new queries and reuses existing row objects and unchanged state', () => {
+        const first = row('2026-10-01T12:00:00.000000001Z');
+        const state = createLiveLogView([first]);
+        const next = mergeLiveLogView(state, [row('2026-10-01T12:00:00.000000002Z'), first], true);
+        expect(next.logs).toHaveLength(2);
+        expect(next.logs[1]).toBe(state.logs[0]);
+        expect(mergeLiveLogView(next, [next.logs[0], first], true)).toBe(next);
+    });
+
+    it('preserves full timestamps and distinguishes immutable request/response fields', () => {
+        const base = row('2026-10-01T12:00:00.000000001Z');
+        const incoming = [
+            row('2026-10-01T12:00:00.000000002Z'),
+            { ...base, client: '192.0.2.20' },
+            { ...base, type: 'AAAA' },
+            { ...base, elapsedMs: '0.014' },
+            { ...base, response: ['A: 192.0.2.1 (ttl=60)'] },
+            { ...base, reason: 'NotFilteredNotFound', status: 'NOERROR' },
+            base,
+        ];
+        expect(mergeLiveLogView(createLiveLogView([base]), incoming, true).logs).toHaveLength(7);
+    });
+
+    it('ignores mutable client metadata and retains multiplicity within a page', () => {
+        const base = row('2026-10-01T12:00:00.123456789Z');
+        const state = createLiveLogView([base, base]);
+        const renamed = { ...base, client_info: { name: 'Renamed client' }, tracker: { name: 'Updated' } };
+        expect(mergeLiveLogView(state, [renamed, renamed], true)).toBe(state);
+        const next = mergeLiveLogView(state, [base, base, base], true);
+        expect(next.logs).toHaveLength(3);
+        expect(new Set(next.logs.map((entry) => entry.liveKey)).size).toBe(3);
+    });
+
+    it('queues arrivals without changing displayed rows until they are revealed', () => {
+        const state = createLiveLogView(rows(5));
+        const pending = mergeLiveLogView(state, rows(2, 5), false);
+        expect(pending.logs).toBe(state.logs);
+        expect(pending.livePending).toHaveLength(2);
+        expect(mergeLiveLogView(pending, rows(2, 5), false)).toBe(pending);
+        const revealed = revealLiveLogs(pending);
+        expect(revealed.logs).toHaveLength(7);
+        expect(revealed.livePending).toHaveLength(0);
+        expect(revealed.logs[2]).toBe(state.logs[0]);
+    });
+
+    it('does not mistake a larger newest page or stale cache for new arrivals', () => {
+        const initial = rows(20, 80);
+        const state = createLiveLogView(initial);
+        const older = mergeLiveLogView(state, rows(100), false);
+        expect(older.logs).toBe(state.logs);
+        expect(older.livePending).toHaveLength(0);
+        const newQueries = mergeLiveLogView(older, rows(100, 2), false);
+        expect(newQueries.livePending).toHaveLength(2);
+        expect(mergeLiveLogView(newQueries, rows(100), false).livePending).toHaveLength(2);
+    });
+
+    it('retains a late completed request within the view window in timestamp order', () => {
+        const state = createLiveLogView(rows(5));
+        const delayed = row('2026-10-01T12:00:00.000000003Z', { elapsedMs: '1200.5' });
+        const next = mergeLiveLogView(state, [...rows(5), delayed], true);
+        expect(next.logs).toHaveLength(6);
+        expect(next.logs[2].elapsedMs).toBe('1200.5');
+        expect(next.logs.map((entry) => entry.time)).toEqual([
+            ...rows(5).slice(0, 3).map((entry) => entry.time),
+            ...rows(5).slice(2).map((entry) => entry.time),
+        ]);
+    });
+
+    it('bounds displayed rows, queued rows, and recent identities in long sessions', () => {
+        let state = createLiveLogView(rows(2000));
+        expect(state.logs).toHaveLength(LIVE_LOG_MAX_ROWS);
+        for (let index = 0; index < 30; index += 1) {
+            state = mergeLiveLogView(state, rows(100, 2000 + index * 100), false);
+            expect(state.logs.length).toBeLessThanOrEqual(500);
+            expect(state.livePending.length).toBeLessThanOrEqual(500);
+            expect(state.liveSeen.length).toBeLessThanOrEqual(500);
+        }
+        const revealed = revealLiveLogs(state);
+        expect(revealed.logs).toHaveLength(500);
+        expect(revealed.livePending).toHaveLength(0);
+    });
+
+    it('clears only the view and does not reinsert an unchanged newest page', () => {
+        let state: any = queryLogs(undefined, { type: '@@init', payload: undefined });
+        state = { ...state, logs: rows(5) };
+        state = queryLogs(state, setLiveLogsEnabled(true));
+        state = queryLogs(state, clearLiveLogsView());
+        expect(state.logs).toEqual([]);
+        state = queryLogs(state, receiveLiveLogs({ logs: rows(5), atTop: true }));
+        expect(state.logs).toEqual([]);
+        state = queryLogs(state, receiveLiveLogs({ logs: rows(6), atTop: true }));
+        expect(state.logs).toHaveLength(1);
+    });
+});
diff --git a/client/src/__tests__/liveQueryLogRecovery.test.ts b/client/src/__tests__/liveQueryLogRecovery.test.ts
new file mode 100644
index 0000000..9803f10
--- /dev/null
+++ b/client/src/__tests__/liveQueryLogRecovery.test.ts
@@ -0,0 +1,436 @@
+import { describe, expect, it, vi } from 'vitest';
+
+import { compareTimes, identifyLiveLogs, LiveLogRow } from '../helpers/liveQueryLog';
+import {
+    LIVE_LOG_RECOVERY_MAX_DURATION_MS, LIVE_LOG_RECOVERY_MAX_PAGES, LIVE_LOG_RECOVERY_MAX_ROWS,
+    LiveLogCheckpoint, LiveLogPage, recoverLiveLogs,
+} from '../helpers/liveQueryLogRecovery';
+
+const time = (value: number) => `2026-10-01T12:00:00.${String(value).padStart(9, '0')}Z`;
+const row = (value: number, extra = {}): LiveLogRow => ({
+    time: time(value), domain: 'example.test', client: '192.0.2.1', type: 'A', ...extra,
+});
+const rows = (count: number, offset = 0) => Array.from({ length: count }, (_, index) => row(count + offset - index));
+const checkpointFor = (entries: LiveLogRow[]): LiveLogCheckpoint => {
+    const identified = identifyLiveLogs([...entries].sort((left, right) => compareTimes(right.time, left.time)));
+    return {
+        time: identified[0]?.time || '',
+        keys: identified.filter((entry) => entry.time === identified[0].time).map((entry) => entry.liveKey!),
+    };
+};
+const baseline = () => checkpointFor([row(1)]);
+const emptyBaseline = (): LiveLogCheckpoint => ({ time: '', keys: [] });
+const page = (logs: LiveLogRow[], oldest = ''): LiveLogPage => ({ logs, oldest });
+const scripted = (...pages: LiveLogPage[]) => {
+    let index = 0;
+    return vi.fn(async (_olderThan?: string) => {
+        const next = pages[index];
+        index += 1;
+        if (!next) {
+            throw new Error('Unexpected extra fetch');
+        }
+        return next;
+    });
+};
+const history = (entries: LiveLogRow[]) => vi.fn(async (olderThan?: string): Promise<LiveLogPage> => {
+    const remaining = olderThan ? entries.filter((entry) => compareTimes(entry.time, olderThan) < 0) : entries;
+    const logs = remaining.slice(0, 100);
+    return page(logs, remaining.length > 100 ? logs[logs.length - 1].time : '');
+});
+
+describe('recoverLiveLogs baselines and catch-up', () => {
+    it('establishes a baseline once with the entire newest timestamp multiset', async () => {
+        const head = row(3);
+        const other = row(3, { domain: 'other.test' });
+        const fetchPage = scripted(page([row(2), head, head, other], time(2)));
+        const result = await recoverLiveLogs(fetchPage, null);
+        expect(fetchPage).toHaveBeenCalledExactlyOnceWith(undefined);
+        expect(result.checkpoint).toEqual(checkpointFor([head, head, other]));
+        expect(result.checkpoint.keys).toHaveLength(3);
+        expect(result.logs.map((entry) => entry.time)).toEqual([time(3), time(3), time(3), time(2)]);
+        expect(result.gap).toBe(false);
+    });
+
+    it('does not retrospectively drain a full initial page', async () => {
+        const fetchPage = scripted(page(rows(100), time(1)));
+        expect((await recoverLiveLogs(fetchPage, null)).gap).toBe(false);
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it('records an empty successful initial baseline without draining its scan cursor', async () => {
+        const fetchPage = scripted(page([], time(100)));
+        expect(await recoverLiveLogs(fetchPage, null)).toEqual({ logs: [], checkpoint: emptyBaseline(), gap: false });
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([0, 20, 99, 100, 250, 500])('recovers %i new rows before UI truncation', async (count) => {
+        const entries = rows(count + 1);
+        const fetchPage = history(entries);
+        const onCatchUp = vi.fn();
+        const result = await recoverLiveLogs(fetchPage, baseline(), { onCatchUp });
+        expect(result.gap).toBe(false);
+        expect(result.logs.map((entry) => entry.time)).toEqual(entries.map((entry) => entry.time));
+        expect(result.logs).toHaveLength(count + 1);
+        expect(new Set(result.logs.map((entry) => entry.liveKey)).size).toBe(count + 1);
+        expect(fetchPage).toHaveBeenCalledTimes(Math.ceil((count + 1) / 100));
+        expect(onCatchUp).toHaveBeenCalledTimes(count >= 100 ? 1 : 0);
+        expect(result.checkpoint).toEqual(checkpointFor(entries.slice(0, 100)));
+    });
+
+    it('bounds 1100 new rows at ten pages and rebases to avoid repeating expensive backfill', async () => {
+        const fetchPage = history(rows(1101));
+        const result = await recoverLiveLogs(fetchPage, baseline());
+        expect(result.gap).toBe(true);
+        expect(result.reason).toBe('page-budget');
+        expect(result.logs).toHaveLength(LIVE_LOG_RECOVERY_MAX_ROWS);
+        expect(result.logs[0].time).toBe(time(1101));
+        expect(result.logs[999].time).toBe(time(102));
+        expect(fetchPage).toHaveBeenCalledTimes(LIVE_LOG_RECOVERY_MAX_PAGES);
+        expect(result.checkpoint).toEqual(checkpointFor(rows(100, 1001)));
+        fetchPage.mockClear();
+        expect((await recoverLiveLogs(fetchPage, result.checkpoint)).gap).toBe(false);
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it('stops on complete first-page overlap while retaining late completed older rows', async () => {
+        const late = row(3, { elapsedMs: '1200' });
+        const fetchPage = scripted(page([late, row(6), row(5)], time(3)));
+        const onCatchUp = vi.fn();
+        const result = await recoverLiveLogs(fetchPage, checkpointFor([row(5)]), { onCatchUp });
+        expect(result.gap).toBe(false);
+        expect(result.logs.map((entry) => entry.time)).toEqual([time(6), time(5), time(3)]);
+        expect(result.logs[2].elapsedMs).toBe('1200');
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+        expect(onCatchUp).not.toHaveBeenCalled();
+    });
+
+    it('preserves full nanoseconds and sorts pages without mutating them', async () => {
+        const input = [row(102), row(104), row(103)];
+        const fetchPage = scripted(page(input, time(102)), page([row(101), row(100)]));
+        const result = await recoverLiveLogs(fetchPage, checkpointFor([row(100)]));
+        expect(result.logs.map((entry) => entry.time)).toEqual([104, 103, 102, 101, 100].map(time));
+        expect(input.map((entry) => entry.time)).toEqual([102, 104, 103].map(time));
+        expect(fetchPage.mock.calls).toEqual([[undefined], [time(102)]]);
+    });
+});
+
+describe('multiset overlap and ambiguous pagination', () => {
+    it('continues partial overlap until every distinct checkpoint head key is found', async () => {
+        const first = row(5, { domain: 'first.test' });
+        const second = row(5, { domain: 'second.test' });
+        const fetchPage = scripted(page([row(6), first], time(5)), page([second, row(4)]));
+        const result = await recoverLiveLogs(fetchPage, checkpointFor([first, second]));
+        expect(result.gap).toBe(false);
+        expect(result.logs).toHaveLength(4);
+        expect(fetchPage).toHaveBeenCalledTimes(2);
+    });
+
+    it('reports partial head loss once the scan passes the checkpoint timestamp', async () => {
+        const first = row(5);
+        const second = row(5, { domain: 'missing.test' });
+        const fetchPage = scripted(page([row(6), first], time(5)), page([row(4)], time(4)));
+        const result = await recoverLiveLogs(fetchPage, checkpointFor([first, second]));
+        expect(result.gap).toBe(true);
+        expect(result.reason).toBe('checkpoint-missing');
+        expect(fetchPage).toHaveBeenCalledTimes(2);
+    });
+
+    it('requires missing occurrence keys rather than accepting one indistinguishable duplicate', async () => {
+        const duplicate = row(5);
+        const fetchPage = scripted(page([row(6), duplicate], time(5)), page([row(4)]));
+        const result = await recoverLiveLogs(fetchPage, checkpointFor([duplicate, duplicate]));
+        expect(fetchPage).toHaveBeenCalledTimes(2);
+        expect(result.gap).toBe(true);
+        expect(result.reason).toBe('ambiguous-frontier');
+    });
+
+    it.each([1, 2])('flags duplicate frontier ambiguity with %i prior occurrences, despite overlap', async (count) => {
+        const duplicate = row(5);
+        const fetchPage = scripted(page([row(6), duplicate, duplicate], time(5)));
+        const result = await recoverLiveLogs(fetchPage, checkpointFor(Array(count).fill(duplicate)));
+        expect(result.logs).toHaveLength(3);
+        expect(result.gap).toBe(true);
+        expect(result.reason).toBe('ambiguous-frontier');
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it('merges overlapping pages with maximum per-page multiplicity instead of summing occurrences', async () => {
+        const duplicate = row(5);
+        const renamed = { ...duplicate, client_info: { name: 'Changed' } };
+        const fetchPage = scripted(
+            page([row(6), duplicate, duplicate], time(5)),
+            page([renamed, renamed, renamed, row(4), row(1)]),
+        );
+        const result = await recoverLiveLogs(fetchPage, baseline());
+        expect(result.gap).toBe(false);
+        expect(result.logs).toHaveLength(6);
+        expect(result.logs.filter((entry) => entry.time === time(5))).toHaveLength(3);
+        expect(new Set(result.logs.map((entry) => entry.liveKey)).size).toBe(6);
+    });
+
+    it.each([false, true])('flags a full-page tied cursor boundary with head overlap=%s', async (overlap) => {
+        const first = row(5, { domain: 'first.test' });
+        const second = row(5, { domain: 'second.test' });
+        const full = [...rows(98, 5), first, second];
+        const fetchPage = scripted(page(full, time(5)), page([row(4), row(1)]));
+        const result = await recoverLiveLogs(fetchPage, overlap ? checkpointFor([first, second]) : baseline());
+        expect(result.gap).toBe(true);
+        expect(result.reason).toBe('ambiguous-page-boundary');
+        expect(fetchPage).toHaveBeenCalledTimes(overlap ? 1 : 2);
+    });
+
+    it('accepts an explicitly exhausted tied full page with distinct identities', async () => {
+        const first = row(5, { domain: 'first.test' });
+        const second = row(5, { domain: 'second.test' });
+        const fetchPage = scripted(page([...rows(98, 5), first, second]));
+        expect((await recoverLiveLogs(fetchPage, checkpointFor([first, second]))).gap).toBe(false);
+    });
+
+    it('accepts timestamp ties away from the cursor boundary', async () => {
+        const entries = [...rows(97, 5), row(5), row(5, { type: 'AAAA' }), row(1)];
+        expect((await recoverLiveLogs(scripted(page(entries, time(1))), baseline())).gap).toBe(false);
+    });
+});
+
+describe('filtered scans, cursor safety, and checkpoint expiry', () => {
+    it('drains a formerly empty baseline through full and short pages to explicit exhaustion', async () => {
+        const fetchPage = scripted(
+            page(rows(100, 200), time(201)), page(rows(2, 100), time(100)), page([row(50)]),
+        );
+        const result = await recoverLiveLogs(fetchPage, emptyBaseline());
+        expect(result.gap).toBe(false);
+        expect(result.logs).toHaveLength(103);
+        expect(fetchPage).toHaveBeenCalledTimes(3);
+    });
+
+    it('does not assume a short newest page is exhausted for a previously empty baseline', async () => {
+        const fetchPage = scripted(page([row(5)], time(4)), page([row(3)]));
+        const result = await recoverLiveLogs(fetchPage, emptyBaseline());
+        expect(result.logs).toHaveLength(2);
+        expect(result.gap).toBe(false);
+        expect(fetchPage).toHaveBeenCalledTimes(2);
+    });
+
+    it('continues through empty scans and checkpoints the newest recovered group', async () => {
+        const fetchPage = scripted(
+            page([], time(10)), page([], time(8)), page([row(7)], time(5)), page([row(1)]),
+        );
+        const result = await recoverLiveLogs(fetchPage, baseline());
+        expect(result.gap).toBe(false);
+        expect(result.logs.map((entry) => entry.time)).toEqual([time(7), time(1)]);
+        expect(result.checkpoint).toEqual(checkpointFor([row(7)]));
+        expect(fetchPage.mock.calls).toEqual([[undefined], [time(10)], [time(8)], [time(5)]]);
+    });
+
+    it('drains empty progressing scans from an empty baseline', async () => {
+        const fetchPage = scripted(page([], time(10)), page([], time(5)), page([]));
+        expect(await recoverLiveLogs(fetchPage, emptyBaseline())).toEqual({
+            logs: [], checkpoint: emptyBaseline(), gap: false,
+        });
+        expect(fetchPage).toHaveBeenCalledTimes(3);
+    });
+
+    it('detects an empty scan passing the frontier without another request', async () => {
+        const fetchPage = scripted(page([], time(4)));
+        expect((await recoverLiveLogs(fetchPage, checkpointFor([row(5)]))).reason).toBe('checkpoint-missing');
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it.each([false, true])('reports expired checkpoints with older rows=%s', async (older) => {
+        const fetchPage = scripted(older ? page([row(3)], time(3)) : page([]));
+        const result = await recoverLiveLogs(fetchPage, checkpointFor([row(5)]));
+        expect(result.gap).toBe(true);
+        expect(result.reason).toBe('checkpoint-missing');
+        expect(result.checkpoint).toEqual(older ? checkpointFor([row(3)])
+            : { ...checkpointFor([row(5)]), limited: true });
+    });
+
+    it.each([undefined, null, 12, 'garbage', '0', '2026-10-01', '2026-10-01T25:00:00Z'])(
+        'guards missing or malformed cursor %s', async (oldest) => {
+            const fetchPage = scripted({ logs: [row(5)], oldest } as LiveLogPage);
+            const result = await recoverLiveLogs(fetchPage, baseline());
+            expect(result.reason).toBe('invalid-cursor');
+            expect(result.gap).toBe(true);
+            expect(fetchPage).toHaveBeenCalledTimes(1);
+        },
+    );
+
+    it('validates initial baseline cursors', async () => {
+        const result = await recoverLiveLogs(scripted(page([row(5)], 'bad')), null);
+        expect(result.reason).toBe('invalid-cursor');
+        expect(result.checkpoint).toEqual(checkpointFor([row(5)]));
+    });
+
+    it.each([time(5), time(6), '2026-10-01T12:00:00.000000005+00:00'])(
+        'guards repeated or increasing cursor %s', async (oldest) => {
+            const fetchPage = scripted(page([row(10)], time(5)), page([], oldest));
+            const result = await recoverLiveLogs(fetchPage, baseline());
+            expect(result.reason).toBe('nonprogressing-cursor');
+            expect(fetchPage).toHaveBeenCalledTimes(2);
+            expect(result.checkpoint).toEqual(checkpointFor([row(10)]));
+        },
+    );
+});
+
+describe('budgets, partial API failures, and cancellation', () => {
+    it('uses the default monotonic 5000ms budget before another request', async () => {
+        const now = vi.spyOn(performance, 'now').mockReturnValueOnce(0).mockReturnValue(5000);
+        try {
+            const fetchPage = scripted(page(rows(100, 100), time(101)));
+            const result = await recoverLiveLogs(fetchPage, baseline());
+            expect(result.reason).toBe('time-budget');
+            expect(result.checkpoint).toEqual(checkpointFor(rows(100, 100)));
+            expect(fetchPage).toHaveBeenCalledTimes(1);
+        } finally {
+            now.mockRestore();
+        }
+        expect(LIVE_LOG_RECOVERY_MAX_DURATION_MS).toBe(5000);
+    });
+
+    it('enforces elapsed duration cumulatively across short pages', async () => {
+        let elapsed = 0;
+        const fetchPage = vi.fn(async () => {
+            elapsed += 2000;
+            return page([row(100 - elapsed / 1000)], time(99 - elapsed / 1000));
+        });
+        const result = await recoverLiveLogs(fetchPage, baseline(), { now: () => elapsed });
+        expect(result.reason).toBe('time-budget');
+        expect(fetchPage).toHaveBeenCalledTimes(3);
+        expect(result.logs).toHaveLength(3);
+    });
+
+    it('supports reduced budgets while capping increased options at hard limits', async () => {
+        const limited = history(rows(1000));
+        expect((await recoverLiveLogs(limited, baseline(), { maxPages: 2 })).reason).toBe('page-budget');
+        expect(limited).toHaveBeenCalledTimes(2);
+        const capped = history(rows(2000));
+        await recoverLiveLogs(capped, baseline(), { maxPages: 100 });
+        expect(capped).toHaveBeenCalledTimes(10);
+        let elapsed = 0;
+        const timed = vi.fn(async () => {
+            elapsed += 5000;
+            return page([row(10)], time(10));
+        });
+        const result = await recoverLiveLogs(timed, baseline(), { now: () => elapsed, maxDurationMs: 100000 });
+        expect(result.reason).toBe('time-budget');
+        expect(timed).toHaveBeenCalledTimes(1);
+    });
+
+    it('returns partial rows and preserves the original checkpoint for retry after API failure', async () => {
+        const original = baseline();
+        const snapshot = JSON.stringify(original);
+        const error = new Error('disconnected');
+        const fetchPage = vi.fn().mockResolvedValueOnce(page([row(3)], time(3))).mockRejectedValueOnce(error);
+        const result = await recoverLiveLogs(fetchPage, original);
+        expect(result.error).toBe(error);
+        expect(result.checkpoint).toBe(original);
+        expect(result.gap).toBe(false);
+        expect(result.reason).toBeUndefined();
+        expect(result.logs).toEqual(identifyLiveLogs([row(3)]));
+        expect(JSON.stringify(original)).toBe(snapshot);
+        const retry = await recoverLiveLogs(history(rows(3)), result.checkpoint);
+        expect(retry.gap).toBe(false);
+        expect(retry.logs).toHaveLength(3);
+    });
+
+    it.each([null, baseline()])('preserves the input checkpoint on initial fetch failure (%s)', async (original) => {
+        const error = new Error('offline');
+        const result = await recoverLiveLogs(vi.fn().mockRejectedValue(error), original);
+        expect(result).toEqual({ logs: [], checkpoint: original, gap: false, error });
+    });
+
+    it('does not mutate frozen checkpoint keys or page rows', async () => {
+        const original = baseline();
+        Object.freeze(original.keys);
+        Object.freeze(original);
+        const entries = [Object.freeze(row(3)), Object.freeze(row(1))];
+        Object.freeze(entries);
+        expect((await recoverLiveLogs(scripted(page(entries)), original)).gap).toBe(false);
+        expect(original).toEqual(baseline());
+    });
+
+    it('requests pages sequentially and invokes the catch-up callback only once', async () => {
+        let active = 0;
+        const fetchPage = vi.fn(async (olderThan?: string) => {
+            active += 1;
+            expect(active).toBe(1);
+            await Promise.resolve();
+            active -= 1;
+            return olderThan ? page([row(1)]) : page([row(3)], time(3));
+        });
+        const onCatchUp = vi.fn();
+        expect((await recoverLiveLogs(fetchPage, baseline(), { onCatchUp })).gap).toBe(false);
+        expect(onCatchUp).toHaveBeenCalledTimes(1);
+    });
+
+    it.each(['signal', 'stale'])('rejects before fetching when cancelled via %s', async (kind) => {
+        const controller = new AbortController();
+        if (kind === 'signal') {
+            controller.abort();
+        }
+        const fetchPage = scripted(page([row(2)]));
+        await expect(recoverLiveLogs(fetchPage, baseline(), {
+            signal: controller.signal, isCurrent: () => kind !== 'stale',
+        })).rejects.toMatchObject({ name: 'AbortError' });
+        expect(fetchPage).not.toHaveBeenCalled();
+    });
+
+    it.each(['signal', 'stale'])('rejects after an in-flight fetch is cancelled via %s', async (kind) => {
+        const controller = new AbortController();
+        let current = true;
+        const original = baseline();
+        const fetchPage = vi.fn(async () => {
+            if (kind === 'signal') {
+                controller.abort();
+            } else {
+                current = false;
+            }
+            return page([row(3), row(1)]);
+        });
+        await expect(recoverLiveLogs(fetchPage, original, {
+            signal: controller.signal, isCurrent: () => current,
+        })).rejects.toMatchObject({ name: 'AbortError' });
+        expect(original).toEqual(baseline());
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it('checks cancellation after onCatchUp before the next request', async () => {
+        const controller = new AbortController();
+        const fetchPage = scripted(page([row(3)], time(3)));
+        await expect(recoverLiveLogs(fetchPage, baseline(), {
+            signal: controller.signal, onCatchUp: () => controller.abort(),
+        })).rejects.toMatchObject({ name: 'AbortError' });
+        expect(fetchPage).toHaveBeenCalledTimes(1);
+    });
+
+    it('rejects independently aborted fetches', async () => {
+        const error = new DOMException('Request deadline', 'AbortError');
+        await expect(recoverLiveLogs(vi.fn().mockRejectedValue(error), baseline()))
+            .rejects.toMatchObject({ name: 'AbortError' });
+    });
+    it('rebases an empty first page onto recovered rows and avoids repeating the page budget', async () => {
+        const initial = scripted(page([], time(50)), page([row(40)], time(40)));
+        const result = await recoverLiveLogs(initial, baseline(), { maxPages: 2 });
+        expect(result.reason).toBe('page-budget');
+        expect(result.checkpoint).toEqual(checkpointFor([row(40)]));
+        const again = scripted(page([], time(50)), page([row(40)], time(40)));
+        const next = await recoverLiveLogs(again, result.checkpoint);
+        expect(next.gap).toBe(false);
+        expect(again).toHaveBeenCalledTimes(2);
+    });
+
+    it('probes only the head after an all-empty scan exhausts its budget', async () => {
+        const initial = scripted(page([], time(50)), page([], time(40)));
+        const result = await recoverLiveLogs(initial, baseline(), { maxPages: 2 });
+        expect(result.checkpoint).toEqual({ ...baseline(), limited: true });
+        const again = scripted(page([], time(50)));
+        const next = await recoverLiveLogs(again, result.checkpoint);
+        expect(again).toHaveBeenCalledTimes(1);
+        expect(next.gap).toBe(true);
+        expect(next.checkpoint).toEqual(result.checkpoint);
+        const fresh = await recoverLiveLogs(scripted(page([row(60)], time(50))), next.checkpoint);
+        expect(fresh.checkpoint).toEqual(checkpointFor([row(60)]));
+        expect(fresh.gap).toBe(true);
+    });
+
+});
