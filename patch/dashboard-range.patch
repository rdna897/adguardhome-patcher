@@ -0,0 +1,255 @@
+import { RefObject, useCallback, useEffect, useRef, useState } from 'react';
+import { shallowEqual, useDispatch, useSelector } from 'react-redux';
+
+import apiClient from '../../api/Api';
+import { addErrorToast } from '../../actions/toasts';
+import {
+    cancelLogsRequest, clearLiveLogsView, receiveLiveLogs, revealPendingLogs, setLiveLogsEnabled,
+} from '../../actions/queryLogs';
+import { normalizeLogs } from '../../helpers/helpers';
+import {
+    LIVE_LOG_INTERVAL_MS, LIVE_LOG_PAGE_SIZE, LIVE_LOG_RETRY_MS,
+    loadLiveLogPreference, saveLiveLogPreference, compareTimes, identifyLiveLogs,
+} from '../../helpers/liveQueryLog';
+import {
+    recoverLiveLogs, checkpointFor, LiveLogCheckpoint, LIVE_LOG_RECOVERY_MAX_DURATION_MS,
+} from '../../helpers/liveQueryLogRecovery';
+import { RootState } from '../../initialState';
+
+export const useLiveQueryLog = (table: RefObject<HTMLDivElement>) => {
+    const dispatch = useDispatch();
+    const { enabled, filter, processingGetConfig, processingGetLogs, livePending } = useSelector(
+        (state: RootState) => state.queryLogs, shallowEqual,
+    );
+    const [live, setLive] = useState(loadLiveLogPreference);
+    const busy = useRef(false);
+    const checkpoint = useRef<LiveLogCheckpoint>(null);
+    const checkpointFilter = useRef(filter ? JSON.stringify(filter) : '{}');
+    const gap = useRef(false);
+    const failed = useRef(false);
+    const abort = useRef<AbortController>();
+    const clearGeneration = useRef(0);
+    const baselineOnly = useRef(false);
+    const observedHead = useRef('');
+    const [clearRevision, setClearRevision] = useState(0);
+    const [phase, setPhase] = useState('catching_up');
+    const [hasGap, setHasGap] = useState(false);
+    const atTop = useRef(true);
+    const filterKey = JSON.stringify(filter || {});
+    const active = useRef(false);
+    const latestFilter = useRef(filterKey);
+    // Passive-effect cleanup can follow a render; stop the old loop immediately.
+    active.current = live && enabled && !processingGetConfig && !processingGetLogs;
+    latestFilter.current = filterKey;
+
+    useEffect(() => {
+        dispatch(setLiveLogsEnabled(live));
+    }, [live]);
+
+    useEffect(() => {
+        if (!live || !enabled || processingGetConfig) {
+            return undefined;
+        }
+        const element = table.current;
+        const onScroll = () => {
+            atTop.current = !element || (element.getBoundingClientRect().top >= -48 && element.scrollTop <= 8);
+            if (atTop.current) {
+                dispatch(revealPendingLogs());
+            }
+        };
+        onScroll();
+        window.addEventListener('scroll', onScroll, { passive: true });
+        element?.addEventListener('scroll', onScroll, { passive: true });
+        return () => {
+            window.removeEventListener('scroll', onScroll);
+            element?.removeEventListener('scroll', onScroll);
+        };
+    }, [live, enabled, processingGetConfig, table]);
+
+    useEffect(() => {
+        if (checkpointFilter.current !== filterKey) {
+            checkpointFilter.current = filterKey;
+            checkpoint.current = null;
+            observedHead.current = '';
+            gap.current = false;
+            baselineOnly.current = false;
+            setHasGap(false);
+            setPhase('catching_up');
+        }
+        if (!live || !enabled || processingGetConfig || processingGetLogs) {
+            return undefined;
+        }
+        let stopped = false;
+        let timer: ReturnType<typeof setTimeout>;
+        let controller: AbortController;
+        let cancelForAvailability: () => void;
+        const generation = clearGeneration.current;
+        const currentFilter = JSON.parse(filterKey);
+        const current = () => !stopped && active.current && latestFilter.current === filterKey
+            && generation === clearGeneration.current;
+        const visible = () => document.visibilityState !== 'hidden';
+        const available = () => visible() && navigator.onLine !== false;
+        async function poll() {
+            if (!current() || !available()) {
+                return;
+            }
+            if (busy.current) {
+                timer = setTimeout(poll, LIVE_LOG_INTERVAL_MS);
+                return;
+            }
+            busy.current = true;
+            controller = new AbortController();
+            abort.current = controller;
+            let timedOut = false;
+            let interrupted = false;
+            let newestPage: any[];
+            const processed = new Map<string, any>();
+            const fromTime = checkpoint.current?.time;
+            // The elapsed budget includes transport time, even for a stalled first page.
+            const deadline = setTimeout(() => {
+                timedOut = true;
+                controller.abort();
+            }, LIVE_LOG_RECOVERY_MAX_DURATION_MS);
+            cancelForAvailability = () => {
+                interrupted = true;
+                clearTimeout(deadline);
+                controller.abort();
+            };
+            try {
+                const result = await recoverLiveLogs(async (olderThan?: string) => {
+                    const response = await apiClient.getQueryLog({
+                        ...currentFilter, limit: LIVE_LOG_PAGE_SIZE,
+                        ...(olderThan ? { older_than: olderThan } : {}),
+                    }, controller.signal);
+                    if (!current() || controller.signal.aborted || !available()) {
+                        throw new DOMException('Live log request cancelled', 'AbortError');
+                    }
+                    // Validate before normalizing: malformed responses must not advance a checkpoint.
+                    if (!response || !Array.isArray(response.data) || response.data.length > LIVE_LOG_PAGE_SIZE
+                        || response.data.some((row: any) => !row || !Number.isFinite(Date.parse(row.time))
+                            || typeof row.time !== 'string' || !row.question
+                            || typeof row.question.name !== 'string' || typeof row.question.type !== 'string')) {
+                        throw new Error('Invalid Query Log response');
+                    }
+                    const logs = normalizeLogs(response.data)
+                        .sort((left: any, right: any) => compareTimes(right.time, left.time));
+                    if (!olderThan) newestPage = logs;
